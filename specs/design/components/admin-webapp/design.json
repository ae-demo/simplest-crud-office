{
  "name": "admin-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "admin-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    11,
    12
  ],
  "description": "The Admin-facing single-page app: sign in, provision guest accounts, manage the full asset inventory, and review/resolve guest requests. Does not expose any guest-only self-service view.",
  "dependencies": [
    {
      "kind": "component",
      "name": "office-api",
      "description": "Manages guest accounts, the full asset inventory, and all guest requests.",
      "wiring": {
        "endpoint": {
          "component": "simplest-crud-office-office-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "OFFICE_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-crud-off-db79328f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
