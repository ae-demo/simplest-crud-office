{
  "name": "office-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "office-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5,
    6,
    8,
    9,
    10,
    11,
    12
  ],
  "description": "Owns the office inventory domain: guest accounts (the employee directory an Admin provisions), assets, and the requests guests raise against them. Serves both the admin and guest web apps behind role-scoped operations. Does not send email or call any service outside the platform.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "office-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "simplest-crud-off-eeefe16e",
        "envBindings": {
          "dbname": "OFFICE_DB_DBNAME",
          "host": "OFFICE_DB_HOST",
          "password": "OFFICE_DB_PASSWORD",
          "port": "OFFICE_DB_PORT",
          "user": "OFFICE_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "simplest-crud-off-db79328f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
